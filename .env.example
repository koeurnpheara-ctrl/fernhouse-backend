# ---------- Copy this file to ".env" and edit the values ----------
#   cp .env.example .env
# Never commit the real .env file to GitHub.

# --- MongoDB (use letters and numbers only in the password) ---
MONGO_ROOT_USER=fernadmin
MONGO_ROOT_PASSWORD=ChangeThisMongoPassword123
MONGO_DB_NAME=fernhouse

# --- Backend ---
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=5

# First admin account (created automatically on first start)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123
# true = add a few sample products when the database is empty
SEED_SAMPLE_DATA=true

# --- Where the website is opened (CORS) ---
# LOCAL TESTING (default):
CORS_ORIGINS=http://localhost:8080
# PRODUCTION (use these instead):
# CORS_ORIGINS=https://myproject.site

# --- Frontend -> API address (baked in at build time!) ---
# LOCAL TESTING (default):
VITE_API_URL=http://localhost:5000/api
# PRODUCTION (use this instead):
# VITE_API_URL=https://api.myproject.site/api

# --- Optional port changes ---
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_LOCAL_PORT=8080
BACKEND_LOCAL_PORT=5000
