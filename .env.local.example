# Backend settings for running WITHOUT Docker:  cp .env.local.example .env
# With Docker Compose, values come from the root .env file instead.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/fernhouse
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# First admin account, created automatically if it does not exist
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345
# true = insert sample products when the products collection is empty
SEED_SAMPLE_DATA=true
